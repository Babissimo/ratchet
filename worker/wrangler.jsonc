{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ratchet-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  // FREEAGENT_CLIENT_ID and FREEAGENT_CLIENT_SECRET are Worker secrets (`wrangler secret put`),
  // or .dev.vars under `wrangler dev`.
  "routes": [
    { "pattern": "auth.ratchet.babissimo.net", "custom_domain": true }
  ],
  // The app hardcodes this hostname, so there is no second copy on workers.dev to drift from it.
  "workers_dev": false,
  "preview_urls": false,
  // A signed-in Ratchet makes about one token call an hour, so this only ever bites a client
  // hammering FreeAgent with Ratchet's credentials.
  "ratelimits": [
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
