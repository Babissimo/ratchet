// Sources/FreeAgentKit/Secrets.swift
//
// Copy this file to `Secrets.swift` (same directory) and fill in the real
// values from your FreeAgent Developer Dashboard app registration
// (https://dev.freeagent.com/). `Secrets.swift` is gitignored — never
// commit real credentials.

// PKCE was tried instead of a client secret (so nothing here would need to stay confidential)
// and reverted after a live test against FreeAgent's sandbox: every token exchange came back
// invalid_grant, because FreeAgent's OAuth app registration is a confidential-client type that
// doesn't recognize PKCE and still requires this secret. See FreeAgentAPIClient.swift.
enum FreeAgentSecrets {
    static let clientID = "YOUR_CLIENT_ID"
    static let clientSecret = "YOUR_CLIENT_SECRET"

    // A client ID/secret pair is only valid against the FreeAgent environment its app was
    // registered in — sandbox credentials get invalid_grant against api.freeagent.com and vice
    // versa. Keeping this alongside the credentials it describes (rather than as a separate
    // build flag) makes it impossible for the two to drift apart.
    static let environment: FreeAgentEnvironment = .sandbox
}
